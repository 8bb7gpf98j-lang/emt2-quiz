          </button><button onclick="jumpToPaletteIndex(90)" class="h-8 text-xs font-semibold rounded-lg border flex items-center justify-center transition-all bg-slate-100 text-slate-600 hover:bg-slate-200 border-slate-200 ">
            91
          </button><button onclick="jumpToPaletteIndex(91)" class="h-8 text-xs font-semibold rounded-lg border flex items-center justify-center transition-all bg-slate-100 text-slate-600 hover:bg-slate-200 border-slate-200 ">
            92
          </button><button onclick="jumpToPaletteIndex(92)" class="h-8 text-xs font-semibold rounded-lg border flex items-center justify-center transition-all bg-slate-100 text-slate-600 hover:bg-slate-200 border-slate-200 ">
            93
          </button><button onclick="jumpToPaletteIndex(93)" class="h-8 text-xs font-semibold rounded-lg border flex items-center justify-center transition-all bg-slate-100 text-slate-600 hover:bg-slate-200 border-slate-200 ">
            94
          </button><button onclick="jumpToPaletteIndex(94)" class="h-8 text-xs font-semibold rounded-lg border flex items-center justify-center transition-all bg-slate-100 text-slate-600 hover:bg-slate-200 border-slate-200 ">
            95
          </button><button onclick="jumpToPaletteIndex(95)" class="h-8 text-xs font-semibold rounded-lg border flex items-center justify-center transition-all bg-slate-100 text-slate-600 hover:bg-slate-200 border-slate-200 ">
            96
          </button><button onclick="jumpToPaletteIndex(96)" class="h-8 text-xs font-semibold rounded-lg border flex items-center justify-center transition-all bg-slate-100 text-slate-600 hover:bg-slate-200 border-slate-200 ">
            97
          </button><button onclick="jumpToPaletteIndex(97)" class="h-8 text-xs font-semibold rounded-lg border flex items-center justify-center transition-all bg-slate-100 text-slate-600 hover:bg-slate-200 border-slate-200 ">
            98
          </button><button onclick="jumpToPaletteIndex(98)" class="h-8 text-xs font-semibold rounded-lg border flex items-center justify-center transition-all bg-slate-100 text-slate-600 hover:bg-slate-200 border-slate-200 ">
            99
          </button><button onclick="jumpToPaletteIndex(99)" class="h-8 text-xs font-semibold rounded-lg border flex items-center justify-center transition-all bg-slate-100 text-slate-600 hover:bg-slate-200 border-slate-200 ">
            100
          </button></div>
    </div>
  </div>


  <!-- SCRIPT LOGIC -->
  <script>
    // ==========================================
    // ROBUST MARKDOWN PARSER FALLBACK
    // ==========================================
    function safeRenderMarkdown(md) {
      if (!md) return '';
      if (typeof marked !== 'undefined' && marked.parse) {
        try {
          let html = marked.parse(md);
          return html.replace(/<table>/g, '<div class="table-wrapper"><table>').replace(/<\/table>/g, '</table></div>');
        } catch(e) {
          console.warn('marked.parse error, using fallback', e);
        }
      }
      
      // Zero-dependency Built-in Markdown Parser Fallback
      let lines = md.split('\n');
      let out = [];
      let inTable = false;
      let inList = false;

      for (let line of lines) {
        line = line.trimEnd();

        // Tables
        if (line.trim().startsWith('|') && line.trim().endsWith('|')) {
          if (!inTable) {
            inTable = true;
            out.push('<div class="table-wrapper"><table>');
          }
          let cells = line.split('|').map(c => c.trim()).filter((c, i, a) => i > 0 && i < a.length - 1);
          if (line.includes('---')) continue; // divider
          let isHeader = !out.join('').includes('<tbody>');
          out.push('<tr>' + cells.map(c => `<${isHeader ? 'th' : 'td'}>${formatInline(c)}</${isHeader ? 'th' : 'td'}>`).join('') + '</tr>');
          continue;
        } else if (inTable) {
          inTable = false;
          out.push('</table></div>');
        }

        // Headings
        if (line.startsWith('### ')) {
          out.push(`<h3>${formatInline(line.substring(4))}</h3>`);
        } else if (line.startsWith('## ')) {
          out.push(`<h2>${formatInline(line.substring(3))}</h2>`);
        } else if (line.startsWith('# ')) {
          out.push(`<h1>${formatInline(line.substring(2))}</h1>`);
        } else if (line.startsWith('> ')) {
          out.push(`<blockquote>${formatInline(line.substring(2))}</blockquote>`);
        } else if (line.startsWith('- ') || line.startsWith('* ')) {
          out.push(`<ul><li>${formatInline(line.substring(2))}</li></ul>`);
        } else if (line.trim() === '---') {
          out.push('<hr class="my-4 border-slate-200">');
        } else if (line.trim().length > 0) {
          out.push(`<p>${formatInline(line)}</p>`);
        }
      }
      if (inTable) out.push('</table></div>');
      return out.join('\n');
    }

    function formatInline(str) {
      if (!str) return '';
      return str
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.+?)\*/g, '<em>$1</em>')
        .replace(/`(.+?)`/g, '<code class="bg-slate-100 text-blue-600 px-1 py-0.5 rounded text-xs">$1</code>');
    }

    // ==========================================
    // APP STATE MANAGEMENT
    // ==========================================
    let chaptersData = [];
    let questionsData = [];
    
    let currentTab = 'notes'; // 'notes' | 'quiz'
    let currentQuizMode = 'random'; // 'random' | 'chapter' | 'all' | 'mock' | 'wrong' | 'bookmarks'
    let currentChapterIndex = 0;
    let currentQuestionIndex = 0; // index in current active question subset
    let activeQuestionsList = []; // the array of questions currently being practiced
    
    // Random 1000 practice sequence
    let random1000List = [];
    let isAutoNext = true;
    let autoNextTimeout = null;
    let currentStreak = 0;
    let maxStreak = 0;
    let currentRangePage = 0; // For palette grid paging on large sets

    // User progress (stored in localStorage)
    let userAnswers = {}; // { global_id: 'A' | 'B' | 'C' | 'D' }
    let wrongAnswers = new Set(); // Set of global_ids
    let bookmarkedQuestions = new Set(); // Set of global_ids
    
    // Mock Exam State
    let mockExamQuestions = [];
    let mockExamAnswers = {};
    let mockTimerInterval = null;
    let mockTimeRemaining = 0;

    // Safe DOM helper
    function setElText(id, text) {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    }
    function setElHtml(id, html) {
      const el = document.getElementById(id);
      if (el) el.innerHTML = html;
    }

    // ==========================================
    // INITIALIZATION
    // ==========================================
    function initApp() {
      loadSavedUserData();
      
      if (window.EMT2_DATA && window.EMT2_DATA.chapters && window.EMT2_DATA.questions) {
        chaptersData = window.EMT2_DATA.chapters;
        questionsData = window.EMT2_DATA.questions;
      } else {
        console.warn("EMT2_DATA not loaded from external file");
      }

      // Initialize random 1000 list
      reshuffleRandomQuestions(false);

      const chkAuto = document.getElementById('chk-auto-next');
      if (chkAuto) chkAuto.checked = isAutoNext;

      renderChapterList();
      renderMobileDrawerChapters();
      populateQuizChapterSelect();
      loadChapterNote(0);
      updateStatsUI();
      updateMobileNavActive();
    }

    if (document.readyState === 'loading') {
      window.addEventListener('DOMContentLoaded', initApp);
    } else {
      initApp();
    }

    function loadSavedUserData() {
      try {
        const savedAns = localStorage.getItem('emt2_user_answers');
        if (savedAns) userAnswers = JSON.parse(savedAns);

        const savedWrong = localStorage.getItem('emt2_wrong_answers');
        if (savedWrong) wrongAnswers = new Set(JSON.parse(savedWrong));

        const savedBookmarks = localStorage.getItem('emt2_bookmarks');
        if (savedBookmarks) bookmarkedQuestions = new Set(JSON.parse(savedBookmarks));

        const savedStreak = localStorage.getItem('emt2_max_streak');
        if (savedStreak) maxStreak = parseInt(savedStreak);

        const savedAutoNext = localStorage.getItem('emt2_auto_next');
        if (savedAutoNext !== null) isAutoNext = (savedAutoNext === 'true');
      } catch (e) {
        console.error("Error loading localStorage data", e);
      }
    }

    function saveUserData() {
      try {
        localStorage.setItem('emt2_user_answers', JSON.stringify(userAnswers));
        localStorage.setItem('emt2_wrong_answers', JSON.stringify(Array.from(wrongAnswers)));
        localStorage.setItem('emt2_bookmarks', JSON.stringify(Array.from(bookmarkedQuestions)));
        localStorage.setItem('emt2_max_streak', maxStreak.toString());
        localStorage.setItem('emt2_auto_next', isAutoNext.toString());
      } catch (e) {
        console.error("Error saving localStorage data", e);
      }
      updateStatsUI();
    }

    function reshuffleRandomQuestions(notify = true) {
      if (!questionsData || questionsData.length === 0) return;
      random1000List = [...questionsData].sort(() => 0.5 - Math.random());
      if (currentQuizMode === 'random') {
        activeQuestionsList = random1000List;
        currentQuestionIndex = 0;
        currentRangePage = 0;
        renderSingleQuestionCard();
        renderPaletteGrid();
      }
      if (notify) alert("üîÄ 1,000 È°åÈ°åÂ∫´Â∑≤ÂÆåÊàêÂÖ®Êñ∞Èö®Ê©üÊ¥óÁâåÔºÅ");
    }

    function toggleAutoNext(val) {
      isAutoNext = val;
      saveUserData();
    }

    // ==========================================
    // PART 1: CHAPTER NOTES
    // ==========================================
    function renderChapterList(filterText = '') {
      const listEl = document.getElementById('notes-chapter-list');
      if (!listEl) return;
      listEl.innerHTML = '';

      chaptersData.forEach((chap, idx) => {
        if (filterText && !chap.title.toLowerCase().includes(filterText.toLowerCase())) {
          return;
        }

        const btn = document.createElement('button');
        const isActive = (idx === currentChapterIndex);
        btn.className = `w-full text-left p-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all flex items-center justify-between group ${
          isActive 
            ? 'bg-blue-600 text-white shadow-sm' 
            : 'hover:bg-slate-100 text-slate-700'
        }`;
        
        btn.onclick = () => loadChapterNote(idx);

        let shortTitle = chap.title.replace(/^Á¨¨\S+Á´†\s*/, '').replace(/_ÈáçÈªûËàáÈ°åÂ∫´.+$/, '').replace(/ÈáçÈªûÊï¥ÁêÜËàáÁ≤æÈÅ∏È°åÂ∫´.+$/, '');
        if (shortTitle.length > 14) shortTitle = shortTitle.substring(0, 14) + '...';

        btn.innerHTML = `
          <div class="flex items-center space-x-2 truncate">
            <span class="w-6 h-6 rounded-lg ${isActive ? 'bg-blue-700 text-white' : 'bg-slate-100 text-slate-500 group-hover:bg-slate-200'} flex items-center justify-center font-bold text-xs flex-shrink-0">
              ${idx + 1}
            </span>
            <span class="truncate">${shortTitle}</span>
          </div>
          <span class="text-[11px] px-1.5 py-0.5 rounded-md font-bold ${isActive ? 'bg-blue-700/80 text-white' : 'bg-slate-100 text-slate-400 group-hover:bg-slate-200'}">
            ${chap.question_count}È°å
          </span>
        `;
        listEl.appendChild(btn);
      });
    }

    function renderMobileDrawerChapters() {
      const listEl = document.getElementById('mob-drawer-chap-list');
      if (!listEl) return;
      listEl.innerHTML = '';

      chaptersData.forEach((chap, idx) => {
        const btn = document.createElement('button');
        const isActive = (idx === currentChapterIndex);
        btn.className = `w-full text-left p-3 rounded-2xl text-xs sm:text-sm font-bold flex items-center justify-between transition-all ${
          isActive ? 'bg-blue-600 text-white shadow-md' : 'bg-slate-50 text-slate-800 hover:bg-slate-100 border border-slate-100'
        }`;
        btn.onclick = () => {
          closeMobileChapterDrawer();
          loadChapterNote(idx);
        };

        btn.innerHTML = `
          <div class="flex items-center space-x-2.5 truncate">
            <span class="w-6 h-6 rounded-lg ${isActive ? 'bg-white text-blue-600' : 'bg-blue-100 text-blue-700'} flex items-center justify-center text-xs font-black flex-shrink-0">
              ${idx + 1}
            </span>
            <span class="truncate">${chap.title.replace(/_ÈáçÈªûËàáÈ°åÂ∫´.+$/, '')}</span>
          </div>
          <span class="text-[11px] px-2 py-0.5 rounded-full ${isActive ? 'bg-blue-700 text-white' : 'bg-slate-200 text-slate-600'} font-bold">
            ${chap.question_count}È°å
          </span>
        `;
        listEl.appendChild(btn);
      });
    }

    function openMobileChapterDrawer() {
      const el = document.getElementById('mob-chap-drawer-modal');
      if (el) {
        el.classList.remove('hidden');
        el.classList.add('flex');
      }
    }
    function closeMobileChapterDrawer() {
      const el = document.getElementById('mob-chap-drawer-modal');
      if (el) {
        el.classList.add('hidden');
        el.classList.remove('flex');
      }
    }

    function loadChapterNote(idx) {
      if (!chaptersData || chaptersData.length === 0) return;
      currentChapterIndex = idx;
      renderChapterList();
      renderMobileDrawerChapters();

      const chap = chaptersData[idx];
      if (!chap) return;

      setElText('notes-chap-tag', `Á¨¨ ${String(idx + 1).padStart(2, '0')} Á´†`);
      setElText('notes-chap-file', `${chap.question_count} È°åÊ®°Êì¨È°åÂ∫´`);
      setElText('notes-chap-title', chap.title);
      setElText('notes-cur-chap-qcount', `${chap.question_count} È°å`);
      setElText('mobile-cur-chap-title', `Á¨¨ ${idx + 1} Á´†Ôºö${chap.title.substring(0, 14)}`);

      // Render markdown note safely
      const rawMd = chap.notes_markdown || "Êö´ÁÑ°Á≠ÜË®òÂÖßÂÆπ";
      setElHtml('notes-body', safeRenderMarkdown(rawMd));

      const bodyEl = document.getElementById('notes-body');
      if (bodyEl) bodyEl.scrollTop = 0;
    }

    function handleNotesSearch(val) {
      renderChapterList(val);
    }

    // ==========================================
    // PART 2: QUIZ & PRACTICE MODES
    // ==========================================
    function populateQuizChapterSelect() {
      const selectEl = document.getElementById('quiz-chapter-select');
      if (!selectEl) return;
      selectEl.innerHTML = '';

      chaptersData.forEach((chap, idx) => {
        const opt = document.createElement('option');
        opt.value = idx;
        opt.textContent = `Á¨¨ ${String(idx + 1).padStart(2, '0')} Á´†Ôºö${chap.title.substring(0, 16)} (${chap.question_count}È°å)`;
        selectEl.appendChild(opt);
      });
    }

    function onQuizChapterSelect(val) {
      currentChapterIndex = parseInt(val);
      startChapterQuiz(currentChapterIndex);
    }

    function startChapterQuiz(chapIdx) {
      currentChapterIndex = chapIdx;
      const selectEl = document.getElementById('quiz-chapter-select');
      if (selectEl) selectEl.value = chapIdx;
      switchAppTab('quiz');
      switchQuizMode('chapter');
    }

    function startRandom1000Mode() {
      switchAppTab('quiz');
      switchQuizMode('random');
    }

    function mobileNavSelect(modeName) {
      if (modeName === 'notes') {
        switchAppTab('notes');
      } else {
        switchAppTab('quiz');
        switchQuizMode(modeName);
      }
      updateMobileNavActive();
    }

    function updateMobileNavActive() {
      const items = ['notes', 'random', 'chapter', 'mock', 'wrong'];
      items.forEach(id => {
        const btn = document.getElementById(`mob-nav-${id}`);
        if (!btn) return;
        const isActive = (currentTab === 'notes' && id === 'notes') || (currentTab === 'quiz' && currentQuizMode === id);
        if (isActive) {
          btn.className = 'flex flex-col items-center justify-center py-1 text-blue-400 font-black scale-105 transition-all';
        } else {
          btn.className = 'flex flex-col items-center justify-center py-1 text-slate-400 font-medium transition-all';
        }
      });
    }

    function switchAppTab(tab) {
      currentTab = tab;
      const secNotes = document.getElementById('section-notes');
      const secQuiz = document.getElementById('section-quiz');
      const tabNotes = document.getElementById('nav-tab-notes');
      const tabQuiz = document.getElementById('nav-tab-quiz');

      if (tab === 'notes') {
        if (secNotes) secNotes.classList.remove('hidden');
        if (secQuiz) secQuiz.classList.add('hidden');
        if (tabNotes) tabNotes.className = 'px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all flex items-center space-x-1.5 bg-blue-600 text-white shadow-sm';
        if (tabQuiz) tabQuiz.className = 'px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all flex items-center space-x-1.5 text-slate-300 hover:text-white hover:bg-slate-700';
      } else {
        if (secNotes) secNotes.classList.add('hidden');
        if (secQuiz) secQuiz.classList.remove('hidden');
        if (tabNotes) tabNotes.className = 'px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all flex items-center space-x-1.5 text-slate-300 hover:text-white hover:bg-slate-700';
        if (tabQuiz) tabQuiz.className = 'px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all flex items-center space-x-1.5 bg-blue-600 text-white shadow-sm';
        
        if (activeQuestionsList.length === 0) {
          switchQuizMode('random');
        }
      }
      updateMobileNavActive();
    }

    function switchQuizMode(mode) {
      currentQuizMode = mode;
      
      // Clear any pending auto-next timers
      if (autoNextTimeout) clearTimeout(autoNextTimeout);

      // Update UI active buttons
      const modes = ['random', 'chapter', 'all', 'mock', 'wrong', 'bookmarks'];
      modes.forEach(m => {
        const btn = document.getElementById(`qmode-${m}`);
        if (btn) {
          if (m === mode) {
            if (m === 'random') {
              btn.className = 'px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs sm:text-sm font-black bg-gradient-to-r from-red-600 via-pink-600 to-indigo-600 text-white shadow-md shadow-red-500/30 whitespace-nowrap transition-all flex items-center space-x-1 flex-shrink-0';
            } else {
              btn.className = 'px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs sm:text-sm font-bold bg-blue-600 text-white shadow-sm whitespace-nowrap transition-all flex items-center space-x-1 flex-shrink-0';
            }
          } else {
            btn.className = 'px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:bg-slate-100 whitespace-nowrap transition-all flex items-center space-x-1 flex-shrink-0';
          }
        }
      });

      const viewCard = document.getElementById('quiz-view-card');
      const viewAll = document.getElementById('quiz-view-all');
      const viewMock = document.getElementById('quiz-view-mock');
      const chapSelect = document.getElementById('quiz-chapter-select');
      const randomBar = document.getElementById('random-helper-bar');
      const modeBadge = document.getElementById('card-mode-badge');

      if (viewCard) viewCard.classList.add('hidden');
      if (viewAll) viewAll.classList.add('hidden');
      if (viewMock) viewMock.classList.add('hidden');

      if (mode === 'random') {
        if (chapSelect) chapSelect.classList.add('hidden');
        if (randomBar) randomBar.classList.remove('hidden');
        if (viewCard) viewCard.classList.remove('hidden');
        if (modeBadge) {
          modeBadge.textContent = 'üîÄ 1000È°åÈö®Ê©üÂø´Âà∑';
          modeBadge.className = 'bg-gradient-to-r from-red-600 to-indigo-600 text-white font-black text-[11px] sm:text-xs px-2 py-0.5 rounded-md shadow-sm';
        }

        if (random1000List.length === 0) {
          reshuffleRandomQuestions(false);
        }
        activeQuestionsList = random1000List;
        currentRangePage = Math.floor(currentQuestionIndex / 100);
        renderSingleQuestionCard();
        renderPaletteGrid();
      }
      else if (mode === 'chapter') {
        if (chapSelect) chapSelect.classList.remove('hidden');
        if (randomBar) randomBar.classList.add('hidden');
        if (viewCard) viewCard.classList.remove('hidden');
        if (modeBadge) {
          modeBadge.textContent = 'üìö Á´†ÁØÄÁ∑¥Áøí';
          modeBadge.className = 'bg-blue-600 text-white font-bold text-[11px] sm:text-xs px-2 py-0.5 rounded-md shadow-sm';
        }

        if (chaptersData[currentChapterIndex]) {
          const targetChapId = chaptersData[currentChapterIndex].chapter_id;
          activeQuestionsList = questionsData.filter(q => q.chapter_id === targetChapId);
        } else {
          activeQuestionsList = questionsData.slice(0, 50);
        }
        currentQuestionIndex = 0;
        currentRangePage = 0;
        renderSingleQuestionCard();
        renderPaletteGrid();
      } 
      else if (mode === 'all') {
        if (chapSelect) chapSelect.classList.add('hidden');
        if (viewAll) viewAll.classList.remove('hidden');
        renderAllQuestionsList();
      }
      else if (mode === 'mock') {
        if (chapSelect) chapSelect.classList.add('hidden');
        if (viewMock) viewMock.classList.remove('hidden');
        showMockSetupView();
      }
      else if (mode === 'wrong') {
        if (chapSelect) chapSelect.classList.add('hidden');
        if (randomBar) randomBar.classList.add('hidden');
        if (viewCard) viewCard.classList.remove('hidden');
        if (modeBadge) {
          modeBadge.textContent = '‚ùå ÈåØÈ°åÂº∑Âåñ';
          modeBadge.className = 'bg-rose-600 text-white font-bold text-[11px] sm:text-xs px-2 py-0.5 rounded-md shadow-sm';
        }

        activeQuestionsList = questionsData.filter(q => wrongAnswers.has(q.global_id));
        if (activeQuestionsList.length === 0) {
          alert("ÁõÆÂâçÈåØÈ°åÊú¨Á©∫Á©∫Â¶Ç‰πüÔºÅÂ§™Ê£í‰∫ÜÔºåÁπºÁ∫å‰øùÊåÅÔºÅ");
          switchQuizMode('random');
          return;
        }
        currentQuestionIndex = 0;
        currentRangePage = 0;
        renderSingleQuestionCard();
        renderPaletteGrid();
      }
      else if (mode === 'bookmarks') {
        if (chapSelect) chapSelect.classList.add('hidden');
        if (randomBar) randomBar.classList.add('hidden');
        if (viewCard) viewCard.classList.remove('hidden');
        if (modeBadge) {
          modeBadge.textContent = '‚≠ê Êî∂ËóèÈ°åÂ∫´';
          modeBadge.className = 'bg-amber-500 text-white font-bold text-[11px] sm:text-xs px-2 py-0.5 rounded-md shadow-sm';
        }

        activeQuestionsList = questionsData.filter(q => bookmarkedQuestions.has(q.global_id));
        if (activeQuestionsList.length === 0) {
          alert("ÁõÆÂâçÂ∞öÊú™Êî∂Ëóè‰ªª‰ΩïÈ°åÁõÆÔºÅÂèØÂú®‰ΩúÁ≠îÊôÇÈªûÈÅ∏ÊòüËôü ‚≠ê ÈÄ≤Ë°åÊî∂Ëóè„ÄÇ");
          switchQuizMode('random');
          return;
        }
        currentQuestionIndex = 0;
        currentRangePage = 0;
        renderSingleQuestionCard();
        renderPaletteGrid();
      }
      updateMobileNavActive();
    }

    // ==========================================
    // CARD MODE: SINGLE QUESTION INTERACTION (‰∏ÄÊ¨°‰∏ÄÈ°åÊåÅÁ∫åÂæÄ‰∏ã)
    // ==========================================
    function renderSingleQuestionCard() {
      if (!activeQuestionsList || activeQuestionsList.length === 0) return;

      const q = activeQuestionsList[currentQuestionIndex];
      if (!q) return;

      if (currentQuizMode === 'random') {
        setElText('card-q-idx', `Á¨¨ ${currentQuestionIndex + 1} È°å / ÂÖ± 1,000 È°å`);
        setElText('card-q-chap', q.chapter_title);
        setElText('card-q-global', `(#${q.global_id})`);
      } else {
        setElText('card-q-idx', `Á¨¨ ${q.id} È°å`);
        setElText('card-q-chap', q.chapter_title);
        setElText('card-q-global', `(#${q.global_id})`);
      }

      setElText('card-q-prompt', q.prompt);
      setElText('card-streak-count', currentStreak);

      // Bookmark button state
      const btnBm = document.getElementById('btn-bookmark');
      if (btnBm) {
        if (bookmarkedQuestions.has(q.global_id)) {
          btnBm.innerHTML = '<span class="text-amber-500 font-bold">‚òÖ</span>';
        } else {
          btnBm.innerHTML = '<span class="text-slate-400">‚òÜ</span>';
        }
      }

      // Render Options (Touch friendly cards)
      const optContainer = document.getElementById('card-options-container');
      if (!optContainer) return;
      optContainer.innerHTML = '';

      const userChoice = userAnswers[q.global_id];
      const hasAnswered = !!userChoice;

      (q.options || []).forEach(optText => {
        const optLetter = optText.substring(1, 2); // 'A', 'B', 'C', 'D'
        const btn = document.createElement('button');
        
        let styleClass = "opt-btn w-full text-left p-3 sm:p-4 rounded-xl sm:rounded-2xl text-xs sm:text-base font-medium border flex items-start space-x-2.5 sm:space-x-3 transition-all ";

        if (!hasAnswered) {
          styleClass += "bg-slate-50/80 border-slate-200/90 hover:bg-blue-50 hover:border-blue-300 text-slate-800 shadow-sm cursor-pointer";
        } else {
          if (optLetter === q.answer) {
            styleClass += "bg-emerald-50 border-emerald-500 text-emerald-900 font-bold shadow-sm";
          } else if (optLetter === userChoice) {
            styleClass += "bg-rose-50 border-rose-500 text-rose-900 line-through font-bold shadow-sm";
          } else {
            styleClass += "bg-slate-50/50 border-slate-200 opacity-60 text-slate-500";
          }
        }

        btn.className = styleClass;
        btn.onclick = () => handleSelectOption(optLetter);

        btn.innerHTML = `
          <span class="w-6 h-6 rounded-lg ${hasAnswered && optLetter === q.answer ? 'bg-emerald-600 text-white' : (hasAnswered && optLetter === userChoice ? 'bg-rose-600 text-white' : 'bg-slate-200 text-slate-700')} flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">
            ${optLetter}
          </span>
          <span class="flex-1 leading-relaxed">${optText.replace(/^\([A-D]\)\s*/, '')}</span>
        `;
        optContainer.appendChild(btn);
      });

      // Explanation Box
      const expBox = document.getElementById('card-explanation-box');
      if (expBox) {
        if (hasAnswered) {
          expBox.classList.remove('hidden');
          setElText('exp-correct-ans', `Ê®ôÊ∫ñÁ≠îÊ°àÔºö(${q.answer})`);
          setElHtml('exp-content', safeRenderMarkdown(q.explanation || "Êö´ÁÑ°Ëß£Êûê"));
        } else {
          expBox.classList.add('hidden');
        }
      }

      updatePaletteItemState(currentQuestionIndex);
    }

    function handleSelectOption(optLetter) {
      const q = activeQuestionsList[currentQuestionIndex];
      if (!q) return;

      if (autoNextTimeout) clearTimeout(autoNextTimeout);

      userAnswers[q.global_id] = optLetter;
      
      const isCorrect = (optLetter === q.answer);
      if (isCorrect) {
        wrongAnswers.delete(q.global_id);
        currentStreak++;
        if (currentStreak > maxStreak) maxStreak = currentStreak;
        try { navigator.vibrate?.(20); } catch(e){}
      } else {
        wrongAnswers.add(q.global_id);
        currentStreak = 0;
        try { navigator.vibrate?.([40, 30, 40]); } catch(e){}
      }

      saveUserData();
      renderSingleQuestionCard();
      renderPaletteGrid();

      // Continuous Auto Next Trigger
      if (isCorrect && isAutoNext && (currentQuestionIndex < activeQuestionsList.length - 1)) {
        autoNextTimeout = setTimeout(() => {
          nextQuestion();
        }, 800);
      }
    }

    function prevQuestion() {
      if (autoNextTimeout) clearTimeout(autoNextTimeout);
      if (currentQuestionIndex > 0) {
        currentQuestionIndex--;
        const newRangePage = Math.floor(currentQuestionIndex / 100);
        if (newRangePage !== currentRangePage) {
          currentRangePage = newRangePage;
          renderPaletteGrid();
        }
        renderSingleQuestionCard();
      }
    }

    function nextQuestion() {
      if (autoNextTimeout) clearTimeout(autoNextTimeout);
      if (currentQuestionIndex < activeQuestionsList.length - 1) {
        currentQuestionIndex++;
        const newRangePage = Math.floor(currentQuestionIndex / 100);
        if (newRangePage !== currentRangePage) {
          currentRangePage = newRangePage;
          renderPaletteGrid();
        }
        renderSingleQuestionCard();
      } else {
        alert("üéâ ÊÅ≠ÂñúÔºÅÊÇ®Â∑≤ÂÆåÊàêÊú¨ÂõûÂêàÁöÑÊâÄÊúâÈ°åÁõÆÔºÅ");
      }
    }

    function jumpToSpecificQuestion(num) {
      const parsed = parseInt(num);
      if (!isNaN(parsed) && parsed >= 1 && parsed <= activeQuestionsList.length) {
        currentQuestionIndex = parsed - 1;
        currentRangePage = Math.floor(currentQuestionIndex / 100);
        renderPaletteGrid();
        renderSingleQuestionCard();
      } else {
        alert(`Ë´ãËº∏ÂÖ• 1 Âà∞ ${activeQuestionsList.length} ‰πãÈñìÁöÑÈ°åËôüÔºÅ`);
      }
    }

    function toggleBookmarkCurrent() {
      const q = activeQuestionsList[currentQuestionIndex];
      if (!q) return;

      if (bookmarkedQuestions.has(q.global_id)) {
        bookmarkedQuestions.delete(q.global_id);
      } else {
        bookmarkedQuestions.add(q.global_id);
      }

      saveUserData();
      renderSingleQuestionCard();
    }

    // ==========================================
    // PALETTE GRID (Á≠îÈ°åÂç°Á∂≤Ê†ºËàáÂàÜÈ†Å)
    // ==========================================
    function renderPaletteGrid() {
      const gridEl = document.getElementById('palette-grid');
      const rangeSelector = document.getElementById('palette-range-selector');
      const mobGridEl = document.getElementById('mob-palette-grid');
      const mobRangeSelector = document.getElementById('mob-palette-range-selector');

      if (gridEl) gridEl.innerHTML = '';
      if (rangeSelector) rangeSelector.innerHTML = '';
      if (mobGridEl) mobGridEl.innerHTML = '';
      if (mobRangeSelector) mobRangeSelector.innerHTML = '';

      const totalLen = activeQuestionsList.length;

      // Range buttons if > 100
      if (totalLen > 100) {
        const totalPages = Math.ceil(totalLen / 100);
        for (let p = 0; p < totalPages; p++) {
          const start = p * 100 + 1;
          const end = Math.min((p + 1) * 100, totalLen);
          const isCurPage = (p === currentRangePage);

          if (rangeSelector) {
            const btn = document.createElement('button');
            btn.className = `px-2 py-0.5 rounded-md font-semibold whitespace-nowrap transition-all ${isCurPage ? 'bg-blue-600 text-white font-bold' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}`;
            btn.textContent = `${start}-${end}`;
            btn.onclick = () => {
              currentRangePage = p;
              renderPaletteGrid();
            };
            rangeSelector.appendChild(btn);
          }

          if (mobRangeSelector) {
            const mobBtn = document.createElement('button');
            mobBtn.className = `px-2.5 py-1 rounded-lg text-xs font-bold whitespace-nowrap transition-all ${isCurPage ? 'bg-blue-600 text-white shadow' : 'bg-slate-100 text-slate-600'}`;
            mobBtn.textContent = `${start}-${end}`;
            mobBtn.onclick = () => {
              currentRangePage = p;
              renderPaletteGrid();
            };
            mobRangeSelector.appendChild(mobBtn);
          }
        }
      }

      const startIndex = (totalLen > 100) ? currentRangePage * 100 : 0;
      const endIndex = (totalLen > 100) ? Math.min((currentRangePage + 1) * 100, totalLen) : totalLen;

      let answeredCount = 0;
      activeQuestionsList.forEach(q => {
        if (userAnswers[q.global_id]) answeredCount++;
      });

      for (let idx = startIndex; idx < endIndex; idx++) {
        const q = activeQuestionsList[idx];
        const userChoice = userAnswers[q.global_id];
        const isCurrent = (idx === currentQuestionIndex);

        let colorClass = "bg-slate-100 text-slate-600 hover:bg-slate-200 border-slate-200";

        if (userChoice) {
          if (userChoice === q.answer) {
            colorClass = "bg-emerald-500 text-white font-bold border-emerald-600";
          } else {
            colorClass = "bg-rose-500 text-white font-bold border-rose-600";
          }
        }

        const btnHtml = `
          <button onclick="jumpToPaletteIndex(${idx})" 
            class="h-8 text-xs font-semibold rounded-lg border flex items-center justify-center transition-all ${colorClass} ${isCurrent ? 'ring-2 ring-blue-600 ring-offset-1 font-black scale-105 shadow' : ''}">
            ${idx + 1}
          </button>
        `;

        if (gridEl) {
          const div = document.createElement('div');
          div.innerHTML = btnHtml;
          gridEl.appendChild(div.firstElementChild);
        }

        if (mobGridEl) {
          const div = document.createElement('div');
          div.innerHTML = btnHtml;
          mobGridEl.appendChild(div.firstElementChild);
        }
      }

      setElText('palette-stats', `${answeredCount} / ${totalLen} È°å`);
    }

    function jumpToPaletteIndex(idx) {
      if (autoNextTimeout) clearTimeout(autoNextTimeout);
      closeMobilePaletteModal();
      currentQuestionIndex = idx;
      renderSingleQuestionCard();
    }

    function updatePaletteItemState(idx) {
      const gridEl = document.getElementById('palette-grid');
      const totalLen = activeQuestionsList.length;
      const startIndex = (totalLen > 100) ? currentRangePage * 100 : 0;
      const localIdx = idx - startIndex;

      if (gridEl) {
        const items = gridEl.children;
        for (let i = 0; i < items.length; i++) {
          if (i === localIdx) {
            items[i].classList.add('ring-2', 'ring-blue-600', 'ring-offset-1', 'font-black', 'scale-105', 'shadow');
          } else {
            items[i].classList.remove('ring-2', 'ring-blue-600', 'ring-offset-1', 'font-black', 'scale-105', 'shadow');
          }
        }
      }
    }

    function openMobilePaletteModal() {
      const el = document.getElementById('mob-palette-modal');
      if (el) {
        el.classList.remove('hidden');
        el.classList.add('flex');
      }
    }
    function closeMobilePaletteModal() {
      const el = document.getElementById('mob-palette-modal');
      if (el) {
        el.classList.add('hidden');
        el.classList.remove('flex');
      }
    }

    // ==========================================
    // FULL QUESTIONS BROWSER (ÂÖ®Â∫´Âø´Âà∑)
    // ==========================================
    let allAnswersVisible = false;

    function renderAllQuestionsList(searchFilter = '') {
      const listEl = document.getElementById('all-questions-list');
      if (!listEl) return;
      listEl.innerHTML = '';

      let filtered = questionsData;
      if (searchFilter) {
        const query = searchFilter.toLowerCase();
        filtered = questionsData.filter(q => 
          q.prompt.toLowerCase().includes(query) || 
          q.options.some(o => o.toLowerCase().includes(query)) ||
          q.chapter_title.toLowerCase().includes(query)
        );
      }

      filtered.forEach((q, idx) => {
        const card = document.createElement('div');
        card.className = "p-4 sm:p-5 rounded-2xl bg-slate-50/80 border border-slate-200/90 flex flex-col space-y-2.5";

        const optionsHtml = q.options.map(opt => `
          <div class="text-xs sm:text-sm text-slate-700 py-1 px-2.5 rounded-lg ${allAnswersVisible && opt.startsWith('(' + q.answer + ')') ? 'bg-emerald-100 text-emerald-900 font-bold border border-emerald-300' : ''}">
            ${opt}
          </div>
        `).join('');

        card.innerHTML = `
          <div class="flex items-center justify-between text-[11px] sm:text-xs text-slate-500 border-b border-slate-200 pb-2">
            <div class="flex items-center space-x-2 truncate pr-2">
              <span class="font-bold text-blue-600 bg-blue-50 px-1.5 py-0.2 rounded">#${q.global_id}</span>
              <span class="truncate">${q.chapter_title} (Á¨¨ ${q.id} È°å)</span>
            </div>
            <button onclick="toggleSingleAns('${q.global_id}')" class="text-blue-600 hover:text-blue-800 font-bold whitespace-nowrap flex-shrink-0">
              Êü•ÁúãËß£Êûê
            </button>
          </div>
          <div class="font-bold text-slate-900 text-sm sm:text-base leading-relaxed">
            ${q.prompt}
          </div>
          <div class="space-y-1">
            ${optionsHtml}
          </div>
          <div id="all-exp-${q.global_id}" class="mt-2 p-3 bg-blue-50/90 rounded-xl border border-blue-200 text-xs text-slate-700 leading-relaxed ${allAnswersVisible ? '' : 'hidden'}">
            <span class="font-bold text-blue-900">Ê®ôÊ∫ñÁ≠îÊ°àÔºö(${q.answer})</span><br>
            ${safeRenderMarkdown(q.explanation || '')}
          </div>
        `;
        listEl.appendChild(card);
      });
    }

    function toggleSingleAns(globalId) {
      const el = document.getElementById(`all-exp-${globalId}`);
      if (el) el.classList.toggle('hidden');
    }

    function toggleAllAnswersVisibility() {
      allAnswersVisible = !allAnswersVisible;
      setElText('btn-toggle-all-ans', allAnswersVisible ? 'üôà Èö±ËóèËß£Êûê' : 'üëÅÔ∏è Â±ïÈñãËß£Êûê');
      const searchEl = document.getElementById('all-search-input');
      renderAllQuestionsList(searchEl ? searchEl.value : '');
    }

    function handleAllQuestionsSearch(val) {
      renderAllQuestionsList(val);
    }

    // ==========================================
    // MOCK EXAM MODE
    // ==========================================
    function showMockSetupView() {
      const setup = document.getElementById('mock-setup-card');
      const container = document.getElementById('mock-exam-container');
      const result = document.getElementById('mock-result-card');
      if (setup) setup.classList.remove('hidden');
      if (container) container.classList.add('hidden');
      if (result) result.classList.add('hidden');
    }

    function startMockExam(count = 50, durationMinutes = 60) {
      const setup = document.getElementById('mock-setup-card');
      const container = document.getElementById('mock-exam-container');
      const result = document.getElementById('mock-result-card');
      if (setup) setup.classList.add('hidden');
      if (container) container.classList.remove('hidden');
      if (result) result.classList.add('hidden');

      const shuffled = [...questionsData].sort(() => 0.5 - Math.random());
      mockExamQuestions = shuffled.slice(0, count);
      mockExamAnswers = {};

      setElText('mock-exam-info', `Ê®°Êì¨ËÄÉ (${count} È°å)`);

      const bodyEl = document.getElementById('mock-q-body');
      if (!bodyEl) return;
      bodyEl.innerHTML = '';

      mockExamQuestions.forEach((q, idx) => {
        const qDiv = document.createElement('div');
        qDiv.className = "mb-6 p-4 sm:p-5 bg-white rounded-xl border border-slate-200 shadow-sm";

        const optHtml = q.options.map(opt => {
          const letter = opt.substring(1, 2);
          return `
            <label class="flex items-center space-x-2.5 p-2.5 rounded-lg border border-slate-200 hover:bg-blue-50/50 cursor-pointer transition-all">
              <input type="radio" name="mock_q_${idx}" value="${letter}" onchange="mockExamAnswers[${idx}] = '${letter}'" class="w-4 h-4 text-blue-600">
              <span class="text-xs sm:text-sm text-slate-800 leading-relaxed">${opt}</span>
            </label>
          `;
        }).join('');

        qDiv.innerHTML = `
          <div class="flex items-center space-x-2 text-[11px] text-slate-400 mb-1.5">
            <span class="font-bold text-blue-600 bg-blue-50 px-1.5 py-0.2 rounded">Á¨¨ ${idx + 1} È°å</span>
            <span>${q.chapter_title}</span>
          </div>
          <div class="text-sm sm:text-base font-bold text-slate-900 mb-3 leading-relaxed">${q.prompt}</div>
          <div class="space-y-2">${optHtml}</div>
        `;
        bodyEl.appendChild(qDiv);
      });

      mockTimeRemaining = durationMinutes * 60;
      if (mockTimerInterval) clearInterval(mockTimerInterval);
      updateTimerDisplay();

      mockTimerInterval = setInterval(() => {
        mockTimeRemaining--;
        updateTimerDisplay();
        if (mockTimeRemaining <= 0) {
          clearInterval(mockTimerInterval);
          alert("‚è∞ ÊôÇÈñìÂà∞ÔºÅÁ≥ªÁµ±Ëá™ÂãïÁÇ∫ÊÇ®‰∫§Âç∑„ÄÇ");
          submitMockExam();
        }
      }, 1000);
    }

    function updateTimerDisplay() {
      const min = Math.floor(mockTimeRemaining / 60);
      const sec = mockTimeRemaining % 60;
      setElText('mock-timer', `${String(min).padStart(2, '0')}:${String(sec).padStart(2, '0')}`);
    }

    function submitMockExam() {
      if (mockTimerInterval) clearInterval(mockTimerInterval);

      let correctCount = 0;
      mockExamQuestions.forEach((q, idx) => {
        const ans = mockExamAnswers[idx];
        if (ans === q.answer) {
          correctCount++;
        } else {
          wrongAnswers.add(q.global_id);
        }
      });

      saveUserData();

      const total = mockExamQuestions.length;
      const score = Math.round((correctCount / total) * 100);
      const isPass = (score >= 60);

      const examContainer = document.getElementById('mock-exam-container');
      const resCard = document.getElementById('mock-result-card');
      if (examContainer) examContainer.classList.add('hidden');
      if (resCard) {
        resCard.classList.remove('hidden');
        resCard.innerHTML = `
          <div class="max-w-xl mx-auto text-center py-2">
            <div class="w-16 h-16 rounded-3xl ${isPass ? 'bg-emerald-100 text-emerald-600' : 'bg-rose-100 text-rose-600'} text-3xl flex items-center justify-center mx-auto mb-3 font-black shadow-inner">
              ${isPass ? 'üèÜ' : '‚ö†Ô∏è'}
            </div>
            <h2 class="text-2xl font-black text-slate-900 mb-1">
              ${isPass ? 'ÊÅ≠ÂñúÂèäÊ†ºÔºÅÊàêÁ∏æÂÑ™Áï∞' : 'Êú™ÈÅîÂèäÊ†ºÊ®ôÊ∫ñÔºåÂÜçÊé•ÂÜçÂé≤ÔºÅ'}
            </h2>
            <p class="text-xs text-slate-500 mb-5">EMT-2 ÊïëË≠∑ÊäÄË°ìÂì°Ê®°Êì¨ËÄÉÊàêÁ∏æÂñÆ</p>

            <div class="grid grid-cols-3 gap-2.5 max-w-sm mx-auto mb-6">
              <div class="p-3 bg-slate-50 rounded-xl border border-slate-200">
                <span class="text-[10px] text-slate-400 block">Á∏ΩÂæóÂàÜ</span>
                <span class="text-2xl font-black ${isPass ? 'text-emerald-600' : 'text-rose-600'}">${score}</span>
                <span class="text-[10px] text-slate-400">/ 100</span>
              </div>
              <div class="p-3 bg-slate-50 rounded-xl border border-slate-200">
                <span class="text-[10px] text-slate-400 block">Á≠îÂ∞ç</span>
                <span class="text-2xl font-black text-blue-600">${correctCount}</span>
                <span class="text-[10px] text-slate-400">/ ${total}</span>
              </div>
              <div class="p-3 bg-slate-50 rounded-xl border border-slate-200">
                <span class="text-[10px] text-slate-400 block">Ê≠£Á¢∫Áéá</span>
                <span class="text-2xl font-black text-indigo-600">${Math.round((correctCount/total)*100)}%</span>
              </div>
            </div>

            <div class="flex items-center justify-center space-x-2">
              <button onclick="startMockExam(${total}, 60)" 
                class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white text-xs font-bold rounded-xl shadow transition-all">
                üîÑ ÂÜçÊ¨°ÊåëÊà∞
              </button>
              <button onclick="switchQuizMode('wrong')" 
                class="px-5 py-2.5 bg-rose-600 hover:bg-rose-700 active:bg-rose-800 text-white text-xs font-bold rounded-xl shadow transition-all">
                ‚ùå Êü•ÁúãÈåØÈ°åÊú¨
              </button>
            </div>
          </div>
        `;
      }
    }

    // ==========================================
    // STATS & PERSISTENCE
    // ==========================================
    function updateStatsUI() {
      const answeredKeys = Object.keys(userAnswers);
      const totalAns = answeredKeys.length;
      
      let correctCount = 0;
      answeredKeys.forEach(gid => {
        const q = questionsData.find(item => item.global_id == gid);
        if (q && q.answer === userAnswers[gid]) {
          correctCount++;
        }
      });

      const accRate = totalAns > 0 ? Math.round((correctCount / totalAns) * 100) : 0;

      setElText('stat-answered', totalAns);
      setElText('stat-accuracy', `${accRate}%`);
      setElText('stat-bookmarks', bookmarkedQuestions.size);
      setElText('stat-wrong', wrongAnswers.size);
      setElText('badge-wrong-count', wrongAnswers.size);
      setElText('badge-bookmark-count', bookmarkedQuestions.size);
    }

    function resetAllProgress() {
      if (confirm("Á¢∫ÂÆöË¶ÅÈáçË®≠ÊâÄÊúâÂÅöÈ°åÁ¥ÄÈåÑ„ÄÅÈåØÈ°åÊú¨ËàáÊî∂ËóèÊ∏ÖÂñÆÂóéÔºü")) {
        userAnswers = {};
        wrongAnswers = new Set();
        bookmarkedQuestions = new Set();
        currentStreak = 0;
        saveUserData();
        if (currentQuizMode === 'random' || currentQuizMode === 'chapter') {
          renderSingleQuestionCard();
          renderPaletteGrid();
        } else {
          switchQuizMode('random');
        }
      }
    }

    // ==========================================
    // KEYBOARD SHORTCUTS
    // ==========================================
    window.addEventListener('keydown', (e) => {
      if (currentTab !== 'quiz' || currentQuizMode === 'all' || currentQuizMode === 'mock') return;
      
      const key = e.key.toUpperCase();
      if (['A', 'B', 'C', 'D'].includes(key)) {
        handleSelectOption(key);
      } else if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'Enter') {
        nextQuestion();
      } else if (e.key === 'ArrowLeft') {
        prevQuestion();
      }
    });
  </script>


