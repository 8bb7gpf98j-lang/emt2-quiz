<body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex flex-col selection:bg-blue-200 pb-20 md:pb-6">

  <!-- TOP APP BAR -->
  <header class="bg-slate-900 text-white sticky top-0 z-40 shadow-md border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-14 sm:h-16">
        
        <!-- Brand Logo & Title -->
        <div class="flex items-center space-x-2.5 cursor-pointer" onclick="switchAppTab('notes')">
          <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-tr from-red-600 via-blue-600 to-indigo-600 flex items-center justify-center text-white text-base sm:text-xl font-black shadow-inner flex-shrink-0">
            üöë
          </div>
          <div>
            <div class="flex items-center space-x-1.5">
              <span class="font-black text-sm sm:text-lg tracking-wide text-white">EMT-2 ÊïëË≠∑ËÄÉË®ìÁ≥ªÁµ±</span>
              <span class="bg-red-600 text-white text-[10px] sm:text-xs px-1.5 py-0.2 rounded font-bold">1000È°å</span>
            </div>
            <p class="text-[10px] sm:text-xs text-slate-400 hidden sm:block">17 Â§ßÁ´†ÁØÄÈáçÈªûÊï¥ÁêÜ ÔºÜ Èö®Ê©üÂø´Âà∑Âà∑È°åÁ≥ªÁµ±</p>
          </div>
        </div>

        <!-- Desktop Mode Nav Switcher (Hidden on Mobile) -->
        <div class="hidden md:flex items-center space-x-1 bg-slate-800/80 p-1 rounded-xl border border-slate-700/60">
          <button id="nav-tab-notes" onclick="switchAppTab('notes')" class="px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all flex items-center space-x-1.5 bg-blue-600 text-white shadow-sm">
            <span>üìå</span>
            <span>ÈáçÈªûÊï¥ÁêÜ</span>
          </button>
          <button id="nav-tab-quiz" onclick="switchAppTab('quiz')" class="px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all flex items-center space-x-1.5 text-slate-300 hover:text-white hover:bg-slate-700">
            <span>üìù</span>
            <span>È°åÂ∫´Ê∏¨È©ó</span>
            <span class="bg-red-500 text-white text-[10px] px-1.5 py-0.2 rounded-full font-bold">1000</span>
          </button>
        </div>

        <!-- Top Right Stats (Always present in DOM to prevent JS errors) -->
        <div class="flex items-center space-x-2 text-xs">
          <div class="flex items-center space-x-2 bg-slate-800/80 px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-lg border border-slate-700">
            <div>
              <span class="text-slate-400 hidden sm:inline">Â∑≤Á≠î:</span>
              <span id="stat-answered" class="font-bold text-blue-400">0</span><span class="text-slate-500 text-[10px]">/1000</span>
            </div>
            <div class="w-px h-3 bg-slate-700"></div>
            <div>
              <span class="text-slate-400 hidden sm:inline">Ê≠£Á¢∫Áéá:</span>
              <span id="stat-accuracy" class="font-bold text-emerald-400">0%</span>
            </div>
            <div class="w-px h-3 bg-slate-700 hidden sm:block"></div>
            <div class="cursor-pointer text-amber-400 hover:text-amber-300 hidden sm:flex items-center space-x-0.5" onclick="switchQuizMode('bookmarks')" title="Êü•ÁúãÊî∂ËóèÊú¨">
              <span>‚≠ê</span>
              <span id="stat-bookmarks" class="font-bold">0</span>
            </div>
            <div class="w-px h-3 bg-slate-700"></div>
            <div class="cursor-pointer text-rose-400 hover:text-rose-300 flex items-center space-x-0.5" onclick="switchQuizMode('wrong')" title="Êü•ÁúãÈåØÈ°åÊú¨">
              <span>‚ùå</span>
              <span id="stat-wrong" class="font-bold">0</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </header>

  <!-- MAIN CONTENT WRAPPER -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-2.5 sm:p-6 lg:p-8 flex flex-col">

    <!-- ======================================================== -->
    <!-- SECTION 1: CHAPTER NOTES (Á¨¨‰∏ÄÈÉ®ÂàÜÔºöÂêÑÁ´†ÁØÄÈáçÈªûÊï¥ÁêÜ) -->
    <!-- ======================================================== -->
